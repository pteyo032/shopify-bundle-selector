{% liquid
  assign product = closest.product
  if request.visual_preview_mode and product == blank
    assign product = collections.all.products.first
  endif

  assign block_settings = block.settings
  assign tier_count = block.blocks.size
%}

{% render 'bundle-selector-styles' %}

{% if product != blank and tier_count == 0 %}
  {% if request.design_mode %}
    <div class="bundle-selector__empty-state">
      {{- 'content.bundle_selector_no_tiers' | t -}}
    </div>
  {% endif %}
{% elsif product != blank %}
  <bundle-selector-component
    class="bundle-selector spacing-style"
    style="
      {% render 'spacing-style', settings: block_settings %}
      {% if block_settings.selected_background_color != blank %}
        --bundle-tier-background: {{ block_settings.selected_background_color }};
      {% endif %}
      {% if block_settings.selected_border_color != blank %}
        --bundle-tier-border-selected: {{ block_settings.selected_border_color }};
      {% endif %}
      {% if block_settings.selected_outline_color != blank %}
        --bundle-tier-outline: {{ block_settings.selected_outline_color }};
      {% endif %}
      {% if block_settings.selected_unit_text_color != blank %}
        --bundle-tier-unit-text: {{ block_settings.selected_unit_text_color }};
      {% endif %}
    "
    data-section-id="{{ section.id }}"
    data-product-id="{{ product.id }}"
    data-product-url="{{ product.url }}"
    data-has-only-default-variant="{{ product.has_only_default_variant }}"
    data-added-text="{{ 'actions.added' | t }}"
    data-unavailable-text="{{ 'products.product.unavailable' | t }}"
    data-select-options-text="{{ 'content.bundle_selector_select_options' | t }}"
    data-savings-format="{{ block_settings.savings_display_format | default: 'percentage' }}"
    {{ block.shopify_attributes }}
    {% if request.visual_preview_mode %}
      data-shopify-visual-preview
    {% endif %}
  >
    <div
      class="bundle-selector__error hidden"
      ref="errorMessage"
      role="alert"
    ></div>
    <div
      class="visually-hidden"
      aria-live="assertive"
      role="status"
      aria-atomic="true"
      ref="liveRegion"
    ></div>

    {%- if block_settings.heading != blank -%}
      <h3
        class="bundle-selector__heading"
        style="
          font-size: {{ block_settings.heading_font_size }}px;
          {% if block_settings.heading_color != blank %}
            color: {{ block_settings.heading_color }};
          {% endif %}
          {% if block_settings.heading_case == 'none' %}
            text-transform: none;
          {% endif %}
        "
      >
        <span>{{ block_settings.heading }}</span>
      </h3>
    {%- endif -%}

    {% render 'bundle-tier-code-warnings' %}

    <div
      class="bundle-selector__tiers"
      ref="tierList"
      role="radiogroup"
      aria-label="{{ 'content.bundle_selector' | t }}"
    >
      {% content_for 'blocks' %}
    </div>

    <button
      type="button"
      class="button bundle-selector__add-to-cart"
      ref="addToCartButton"
      on:click="/addToCart"
      {% unless product.available %}
        disabled
      {% endunless %}
    >
      <span ref="addToCartButtonText">
        {%- if product.available -%}
          {{ 'products.product.add_to_cart' | t }}
        {%- else -%}
          {{ 'products.product.sold_out' | t }}
        {%- endif -%}
      </span>
    </button>

    <script type="application/json" ref="variantsData">
      {{ product.variants | json }}
    </script>
  </bundle-selector-component>

  <script
    src="{{ 'bundle-selector.js' | asset_url }}"
    type="module"
  ></script>
{% endif %}

{% schema %}
{
  "name": "t:names.bundle_selector",
  "tag": null,
  "blocks": [
    {
      "type": "bundle-tier"
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "Bundle & Save"
    },
    {
      "type": "header",
      "content": "t:content.typography"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "label": "t:settings.heading_font_size",
      "min": 12,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 22
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "t:settings.heading_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "select",
      "id": "heading_case",
      "label": "t:settings.case",
      "options": [
        {
          "value": "uppercase",
          "label": "t:options.uppercase"
        },
        {
          "value": "none",
          "label": "t:options.default"
        }
      ],
      "default": "uppercase"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "color",
      "id": "selected_background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default",
      "info": "t:info.bundle_selector_selected_style"
    },
    {
      "type": "color",
      "id": "selected_border_color",
      "label": "t:settings.savings_badge_background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "select",
      "id": "savings_display_format",
      "label": "t:settings.savings_display_format",
      "options": [
        {
          "value": "percentage",
          "label": "t:options.percentage"
        },
        {
          "value": "amount",
          "label": "t:options.amount"
        }
      ],
      "default": "percentage"
    },
    {
      "type": "color",
      "id": "selected_outline_color",
      "label": "t:settings.border_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "color",
      "id": "selected_unit_text_color",
      "label": "t:settings.unit_text_color",
      "placeholder": "t:settings.default",
      "info": "t:info.bundle_selector_selected_style"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:names.bundle_selector",
      "category": "t:categories.product",
      "blocks": {
        "tier-1": {
          "type": "bundle-tier",
          "settings": {
            "label": "t:text_defaults.buy_one",
            "unit_count": 1,
            "discount_type": "percentage",
            "discount_percentage": 0,
            "default_selected": true
          }
        },
        "tier-2": {
          "type": "bundle-tier",
          "settings": {
            "label": "t:text_defaults.buy_two_get_one_free",
            "unit_count": 3,
            "discount_type": "free_units",
            "discount_free_units": 1,
            "badge_enabled": true,
            "badge_text": "t:text_defaults.most_popular"
          }
        }
      },
      "block_order": ["tier-1", "tier-2"]
    }
  ]
}
{% endschema %}
